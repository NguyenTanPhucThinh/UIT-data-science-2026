# Git LFS configuration for large datasets
# Large datasets
data/processed/corpus.jsonl filter=lfs diff=lfs merge=lfs -text
data/raw/selected-contexts.zip filter=lfs diff=lfs merge=lfs -text
# All ZIP files
*.zip filter=lfs diff=lfs merge=lfs -text
# All JSONL files
*.jsonl filter=lfs diff=lfs merge=lfs -text
# Embeddings and FAISS vector store
*.npy filter=lfs diff=lfs merge=lfs -text
*.index filter=lfs diff=lfs merge=lfs -text
embeddings/corpus_embeddings.npy filter=lfs diff=lfs merge=lfs -text
